# EvalNexa — Production Server Environment Template (Render Backend)
# DO NOT COMMIT REAL CREDENTIALS. USE PLACEHOLDERS ONLY.

# Server Core
NODE_ENV=production
PORT=5000

# Database (MongoDB Atlas)
MONGODB_URI=<YOUR_MONGODB_ATLAS_URI>

# Authentication
JWT_SECRET=<YOUR_PRODUCTION_JWT_SECRET>
JWT_EXPIRES_IN=7d

# Production Frontend Origins (Cloudflare Pages Custom Subdomains)
CLIENT_CONTROL_CENTER_URL=https://control.shivasoni.me
CLIENT_EXAMINER_URL=https://examiner.shivasoni.me
CLIENT_MODERATION_URL=https://moderation.shivasoni.me

# Optional: Extra comma-separated origins (e.g. Cloudflare Pages preview URLs)
# ALLOWED_ORIGINS=https://preview-id.pages.dev

# Cloudinary Storage & Media Ingestion
CLOUDINARY_CLOUD_NAME=<YOUR_CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API_KEY=<YOUR_CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<YOUR_CLOUDINARY_API_SECRET>

# Script Ingestion Key (For automated batch ingestion)
INGESTION_API_KEY=<YOUR_INGESTION_API_KEY>

# Google Gemini AI Assistant
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
GEMINI_MODEL=gemini-3.1-flash-lite
