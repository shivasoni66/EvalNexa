{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@evalnexa/ui": ["../../packages/ui/src/index.ts"],
      "@evalnexa/ui/styles": ["../../packages/ui/src/styles/index.css"],
      "@evalnexa/types": ["../../packages/types/src/index.ts"]
    }
  },
  "include": ["src"]
}
